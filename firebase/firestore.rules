rules_version = '2';

// HomeCare のFirestoreセキュリティルール。
// 「家のメンバー（memberUids に入っている利用者）だけが、その家のデータを読み書きできる」ようにする。
// Firebaseコンソールの Firestore Database →「ルール」に、このファイルの中身を貼り付けて公開する。
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function homePath(homeId) {
      return /databases/$(database)/documents/homes/$(homeId);
    }

    // 今の時点でメンバーか（読むとき）
    function isMember(homeId) {
      return signedIn() && request.auth.uid in get(homePath(homeId)).data.memberUids;
    }

    // 書き込みの後にメンバーか（家を作るのと同時に部屋などを書き込めるようにする）
    function isMemberAfterWrite(homeId) {
      return signedIn() && request.auth.uid in getAfter(homePath(homeId)).data.memberUids;
    }

    // 招待コードで参加するときの決まり：
    // ・メンバー一覧の最後に自分を1人足すだけ（ほかの人は足せない・消せない）
    // ・変えてよいのはメンバー一覧と、使った招待コード（joinCode）だけ
    // ・その招待コードが本当にこの家のもので、期限内であること
    function isJoiningWithInvite(homeId) {
      let invite = get(/databases/$(database)/documents/invites/$(request.resource.data.joinCode));
      return signedIn()
        && !(request.auth.uid in resource.data.memberUids)
        && request.resource.data.memberUids == resource.data.memberUids.concat([request.auth.uid])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids', 'joinCode'])
        && invite.data.homeId == homeId
        && request.time.toMillis() < invite.data.expiresAtMillis;
    }

    // 自分が家から抜けるときの決まり：
    // ・メンバー一覧から自分だけを消す（ほかの人は消せない）
    // ・家を作った持ち主は抜けられない（家族が使えなくならないように）
    function isLeaving() {
      return signedIn()
        && request.auth.uid in resource.data.memberUids
        && request.auth.uid != resource.data.ownerUid
        && request.resource.data.memberUids == resource.data.memberUids.removeAll([request.auth.uid])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids']);
    }

    // 持ち主がほかのメンバーを外すときの決まり：
    // ・1人だけを消す。足したり、持ち主自身を消したりはできない
    function isRemovingByOwner() {
      return signedIn()
        && request.auth.uid == resource.data.ownerUid
        && request.auth.uid in request.resource.data.memberUids
        && resource.data.memberUids.hasAll(request.resource.data.memberUids)
        && request.resource.data.memberUids.size() == resource.data.memberUids.size() - 1
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids']);
    }

    match /homes/{homeId} {
      // まだ無い家を取得しようとしたときは「無い」と返す（家IDは推測できないUUID）
      allow get: if signedIn() && (resource == null || request.auth.uid in resource.data.memberUids);
      // 自分がメンバーの家だけを探せる
      allow list: if signedIn() && request.auth.uid in resource.data.memberUids;

      // 家を作れるのは、自分を持ち主かつ唯一のメンバーにするときだけ
      allow create: if signedIn()
        && request.resource.data.id == homeId
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.memberUids == [request.auth.uid];

      // メンバーは家の名前などを変えられるが、持ち主とメンバー一覧は変えられない。
      // メンバー一覧を変えられるのは、招待コードで参加する・自分が抜ける・持ち主が外す、の3つだけ
      allow update: if (signedIn()
          && request.auth.uid in resource.data.memberUids
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.memberUids == resource.data.memberUids)
        || isJoiningWithInvite(homeId)
        || isLeaving()
        || isRemovingByOwner();

      // 削除は deletedAt で行うので、ドキュメントは消させない
      allow delete: if false;

      match /{collection}/{docId} {
        allow read: if isMember(homeId);
        allow create, update: if collection in ['rooms', 'points', 'tasks', 'completions']
          && isMemberAfterWrite(homeId)
          && request.resource.data.id == docId;
        allow delete: if false;
      }

      // メンバーの呼び名。読むのは上の決まり（メンバーなら読める）。
      // 書けるのは自分の分だけ。消せるのは、抜ける本人か家の持ち主
      match /members/{uid} {
        allow create, update: if signedIn()
          && request.auth.uid == uid
          && request.resource.data.uid == uid
          && request.resource.data.name is string
          && request.resource.data.name.size() <= 20
          && isMemberAfterWrite(homeId);
        allow delete: if signedIn()
          && (request.auth.uid == uid || request.auth.uid == get(homePath(homeId)).data.ownerUid);
      }
    }

    // 招待。コードを知っている人だけが取得できる（一覧で探すことはできない）
    match /invites/{code} {
      allow get: if signedIn();
      allow list: if false;
      // 招待を作れるのは、その家のメンバーだけ。期限は最長1日（端末の時計のずれを見て少し余裕を持たせる）
      allow create: if signedIn()
        && request.resource.data.code == code
        && request.resource.data.createdByUid == request.auth.uid
        && request.auth.uid in get(homePath(request.resource.data.homeId)).data.memberUids
        && request.resource.data.expiresAtMillis > request.time.toMillis()
        && request.resource.data.expiresAtMillis < request.time.toMillis() + 25 * 60 * 60 * 1000;
      allow update, delete: if false;
    }
  }
}
